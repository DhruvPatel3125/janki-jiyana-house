{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "server/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/sitemap.xml",
      "dest": "/server/server.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server/server.js"
    },
    {
      "src": "^/(?!api/)(.*)$",
      "dest": "/client/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(?!api/)(.*)$",
      "dest": "/client/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "janki-jiyana-house.vercel.app"
        }
      ],
      "destination": "https://www.jankijiyanahouse.com/$1",
      "permanent": true
    }
  ]
}
